{
	"hooks": {
		"SubagentStop": [
			{
				"matcher": "^lazygrok-executor$|^lazycodex-executor$|^lazygrok-worker-(low|medium|high)$|^lazycodex-worker-(low|medium|high)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook subagent-stop",
						"timeout": 10,
						"statusMessage": "(LazyGrok 4.19.3) Verifying Worker Evidence"
					}
				]
			}
		]
	}
}
