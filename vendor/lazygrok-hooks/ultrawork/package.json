{
  "name": "@code-yeongyu/codex-ultrawork",
  "version": "4.19.3",
  "description": "Codex plugin that injects the ultrawork orchestration directive and ships LazyCodex planning, review, QA, and gate agent roles. (LazyGrok Grok-patched skill-pointer)",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "license": "MIT",
  "homepage": "https://github.com/code-yeongyu/codex-ultrawork",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-yeongyu/codex-ultrawork.git"
  },
  "bugs": {
    "url": "https://github.com/code-yeongyu/codex-ultrawork/issues"
  },
  "keywords": [
    "codex",
    "codex-plugin",
    "ultrawork",
    "agents",
    "hooks",
    "orchestration"
  ],
  "bin": {
    "omo-ultrawork": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/sync-directive.mjs && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && bun build src/cli.ts --target node --format esm --outfile dist/cli.js",
    "test": "node --test scripts/sync-directive.test.mjs skills/ulw-plan/scripts/scaffold-plan.test.mjs",
    "test:watch": "node --test --watch scripts/sync-directive.test.mjs skills/ulw-plan/scripts/scaffold-plan.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "tsc --noEmit && biome check . && npm run build"
  },
  "files": [
    "agents",
    "dist",
    "directive.md",
    "hooks",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
